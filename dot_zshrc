##============================
## .zshrc
##============================

## History (shared across sessions, deduped; mirrors .bashrc)
HISTSIZE=10000
SAVEHIST=$HISTSIZE
HISTFILE="$HOME/.zsh_history"
setopt append_history
setopt share_history
setopt hist_ignore_dups
setopt hist_ignore_all_dups
setopt hist_save_no_dups

## Options
setopt ignore_eof

## Line Editing (vi mode, as in .bashrc)
# zsh already picks vi mode when $EDITOR contains "vi"; make it explicit.
bindkey -v

# Up/Down search history by the typed prefix (as ~/.inputrc does for bash).
autoload -U up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
for __keymap in viins vicmd; do
  bindkey -M "$__keymap" '^[[A' up-line-or-beginning-search
  bindkey -M "$__keymap" '^[OA' up-line-or-beginning-search
  bindkey -M "$__keymap" '^[[B' down-line-or-beginning-search
  bindkey -M "$__keymap" '^[OB' down-line-or-beginning-search
done
unset __keymap

# Shift-Tab cycles completions backward.
bindkey -M viins '^[[Z' reverse-menu-complete

## ZPlug (autosuggestions + syntax highlighting)
if command -v brew &>/dev/null; then
  export ZPLUG_HOME="$(brew --prefix zplug 2>/dev/null)"
elif [ -d "$HOME/.zplug" ]; then
  export ZPLUG_HOME="$HOME/.zplug"
fi
if [ -n "${ZPLUG_HOME:-}" ] && [ -d "${ZPLUG_HOME}" ]; then
  source "${ZPLUG_HOME}/init.zsh"

  zplug "zsh-users/zsh-autosuggestions"
  zplug "zsh-users/zsh-syntax-highlighting", defer:2

  if ! zplug check --verbose; then
    printf "Install? [y/N]: "
    if read -rq; then
      echo
      zplug install
    fi
  fi
  zplug load
fi

## Completion
if ! command -v compdef &>/dev/null; then
  autoload -U compinit && compinit
fi
# Color completion lists like readline's colored-stats.
zstyle ':completion:*' list-colors "${(@s.:.)LS_COLORS}"

## Shared Interactive Config
if [ -f "$HOME/.config/shell/interactive.sh" ]; then
  source "$HOME/.config/shell/interactive.sh"
fi

## Starship
if command -v starship &>/dev/null; then
  # Clear stale line state before each prompt render in zsh.
  __sanitize_prompt() { printf '\r\033[K'; }
  if ((${precmd_functions[(Ie)__sanitize_prompt]} == 0)); then
    precmd_functions+=(__sanitize_prompt)
  fi

  # Starship's zsh init wraps zle-keymap-select. Re-running it makes the wrapper
  # preserve itself, then Escape in vi mode recurses until FUNCNEST is reached.
  # The widget name lives in a variable because shfmt rewrites a literal
  # subscript like [zle-keymap-select] into arithmetic ([zle - keymap - select]).
  __starship_keymap_widget='zle-keymap-select'
  if (($+functions[prompt_starship_precmd] == 0)); then
    eval "$(starship init zsh)"
  elif [[ ${widgets[$__starship_keymap_widget]:-} == user:starship_zle-keymap-select-wrapped &&
    ${__starship_preserved_zle_keymap_select:-} == starship_zle-keymap-select-wrapped ]]; then
    zle -N zle-keymap-select starship_zle-keymap-select
    unset __starship_preserved_zle_keymap_select
  fi
  unset __starship_keymap_widget
fi

## Apply Base Path Order
if (($+functions[_zsh_apply_base_path_order])); then
  _zsh_apply_base_path_order
fi
