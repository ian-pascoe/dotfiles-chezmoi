{
  "name": "chezmoi",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "./dot_pi/agent",
    "./dot_config/opencode"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit",
    "update": "npm-check-updates --workspaces -u && npm install"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260522.1",
    "npm-check-updates": "^22.2.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
