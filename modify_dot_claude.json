#!/bin/sh
# Manage only mcpServers; the rest of ~/.claude.json is Claude Code state.
# jq keeps the existing key order, so diffs show only real changes.
set -eu

input=$(cat)
[ -n "$input" ] || input='{}'
printf '%s\n' "$input" |
  jq -j --slurpfile servers "$CHEZMOI_SOURCE_DIR/dot_claude/mcp-servers.json" \
    '.mcpServers = $servers[0]'
