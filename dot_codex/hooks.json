{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/bin/moshi-hook\" codex-hook",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 \"$HOME/.codex/skills/codex-autoresearch/scripts/autoresearch_hook_session_start.py\"",
            "statusMessage": "codex-autoresearch SessionStart hook",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|compact"
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/bin/moshi-hook\" codex-hook",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 \"$HOME/.codex/skills/codex-autoresearch/scripts/autoresearch_hook_stop.py\"",
            "statusMessage": "codex-autoresearch Stop hook",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/bin/moshi-hook\" codex-hook",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/bin/moshi-hook\" codex-hook",
            "type": "command"
          }
        ]
      }
    ]
  }
}
