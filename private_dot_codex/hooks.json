{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$HOME/.codex/skills/codex-autoresearch/scripts/autoresearch_hook_session_start.py\"",
            "statusMessage": "codex-autoresearch SessionStart hook",
            "timeout": 5
          }
        ],
        "matcher": "startup|resume|compact"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$HOME/.codex/skills/codex-autoresearch/scripts/autoresearch_hook_stop.py\"",
            "statusMessage": "codex-autoresearch Stop hook",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env zsh -lc 'plannotator'",
            "timeout": 345600
          }
        ]
      }
    ]
  }
}
