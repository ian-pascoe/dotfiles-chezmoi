#!/usr/bin/env python3
"""Export host inventories without changing curated install manifests (Python 3.9+)."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from package_manifests import (  # noqa: E402
    MANAGERS, InventoryUnavailable, capture, find_executable, inventory, name_of, scoop_apps,
)


def json_snapshot(data):
    return json.dumps(data, indent=2, sort_keys=True, ensure_ascii=False) + "\n"


def collect():
    snapshots = {}
    for manager, (filename, executable, _) in MANAGERS.items():
        executable = "apt-mark" if manager == "apt" else executable
        if not find_executable(executable):
            print(f"Skipping {manager}: not installed; previous snapshot left unchanged.")
            continue
        if manager == "apt":
            names = set(capture("apt-mark", "showmanual").splitlines()) - {""}
            if any(name_of("apt", name) != name for name in names):
                raise ValueError("Invalid apt inventory")
        else:
            try:
                names = inventory(manager, for_pruning=False)[0]
            except InventoryUnavailable as error:
                print(f"Skipping {manager}: {error}; previous snapshot left unchanged.")
                continue
        snapshots[filename] = f"# {manager} host inventory (not install intent)\n# One package name per line.\n" + "".join(name + "\n" for name in sorted(names))
    for manager, command, filename in (
        ("scoop", ["scoop", "export"], "scoopfile.json"),
        ("mise", ["mise", "ls", "--installed", "--json"], "mise.json"),
        ("brew", ["brew", "info", "--json=v2", "--installed"], "brew.json"),
    ):
        if not find_executable(manager):
            print(f"Skipping {manager}: not installed; previous snapshot left unchanged.")
            continue
        data = json.loads(capture(*command))
        if not isinstance(data, dict):
            raise ValueError(f"Invalid {manager} JSON inventory")
        if manager == "scoop":
            apps = scoop_apps(data)
            data["apps"] = [apps[key] for key in sorted(apps)]
            if "buckets" in data:
                buckets = data["buckets"]
                if not isinstance(buckets, list) or not all(isinstance(bucket, dict) for bucket in buckets):
                    raise ValueError("Invalid Scoop bucket inventory")
                data["buckets"] = sorted(buckets, key=json_snapshot)
        elif manager == "mise":
            if not all(isinstance(records, list) and all(isinstance(record, dict) and isinstance(record.get("version"), str) for record in records) for records in data.values()):
                raise ValueError("Invalid Mise version inventory")
            data = {name: sorted(records, key=json_snapshot) for name, records in data.items()}
        else:
            for key in ("formulae", "casks"):
                if not isinstance(data.get(key), list) or not all(isinstance(record, dict) for record in data[key]):
                    raise ValueError("Invalid Homebrew inventory")
                data[key] = sorted(data[key], key=json_snapshot)
        snapshots[filename] = json_snapshot(data)
    return snapshots


def write_snapshot(path, content):
    if path.exists() and path.read_bytes() == content.encode("utf-8"):
        return
    # Same-directory replacement is atomic; temporary snapshots start owner-only.
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", newline="\n", dir=path.parent, prefix=".inventory-", delete=False) as stream:
            temporary = Path(stream.name)
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def main():
    state = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state")))
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output-dir", "--manifest-dir", type=Path,
                        default=Path(os.environ.get("MANIFEST_DIR", str(state / "package-inventory"))),
                        help="Inventory destination (MANIFEST_DIR overrides the XDG state default)")
    parser.add_argument("--dry-run", action="store_true", help="Collect and validate inventories, but write nothing")
    args = parser.parse_args()
    output = args.output_dir.resolve()
    config = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
    curated = {config / "packages", config / "scoop", Path.home() / ".config/packages", Path.home() / ".config/scoop"}
    if os.environ.get("PACKAGE_MANIFEST_DIR"):
        curated.add(Path(os.environ["PACKAGE_MANIFEST_DIR"]))
    if output in {path.resolve() for path in curated}:
        raise ValueError(f"Refusing to overwrite curated install manifests: {output}")
    print(f"Exporting host package inventory to {output} (inventory only; not curated install manifests).")
    # Unexpected collector failures abort before any existing snapshot changes.
    snapshots = collect()
    if snapshots and not args.dry_run:
        output.mkdir(parents=True, exist_ok=True)
    for filename, content in snapshots.items():
        path = output / filename
        if args.dry_run:
            print(f"Would export {path}")
        else:
            write_snapshot(path, content)
            print(f"Exported {path}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, TypeError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"sync-package-manifests: {error}", file=sys.stderr)
        sys.exit(1)
