#!/usr/bin/env python3
"""Install curated packages; explicitly opt into dependency-aware pruning."""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from package_manifests import (  # noqa: E402
    MANAGERS, InventoryUnavailable, capture, cargo_root, confirm, find_executable, inventory,
    name_of, run, scoop_apps,
)


def scoop_plan(wanted):
    installed = scoop_apps(json.loads(capture("scoop", "export")))
    if wanted - installed.keys() or any("install failed" in installed[key].get("info", "").lower() for key in wanted):
        raise RuntimeError("Configured Scoop apps are missing or failed; complete installation before pruning")
    # prefix chooses the local copy first; refuse ambiguous dual-scope inspections.
    if len({name for name, _ in installed}) != len(installed):
        raise RuntimeError("Cannot safely inspect duplicate local/global Scoop copies")
    retained = set(wanted)
    retained.update(key for key, record in installed.items()
                    if key[0] in {"scoop", "git", "mise", "7zip", "pwsh", "powershell"}
                    or key[0].startswith("python") or "held package" in record.get("info", "").lower())
    pending = list(retained)
    while pending:
        name, _ = pending.pop()
        prefix = capture("scoop", "prefix", name).strip()
        if not prefix or not Path(prefix).is_absolute():
            raise ValueError(f"Invalid Scoop prefix for {name}")
        manifest = json.loads((Path(prefix) / "manifest.json").read_text(encoding="utf-8-sig"))
        if not isinstance(manifest, dict):
            raise ValueError(f"Invalid installed Scoop manifest for {name}")
        # Include every architecture's dependencies conservatively.
        objects = [manifest]
        while objects:
            item = objects.pop()
            if isinstance(item, dict):
                objects.extend(value for key, value in item.items() if key != "depends")
                depends = item.get("depends", [])
                if isinstance(depends, str):
                    depends = [depends]
                if not isinstance(depends, list) or not all(isinstance(dep, str) for dep in depends):
                    raise ValueError(f"Invalid Scoop dependencies for {name}")
                for dep in depends:
                    dep_name = dep.rsplit("/", 1)[-1].lower()
                    matches = {key for key in installed if key[0] == dep_name}
                    if not matches:
                        raise RuntimeError(f"Missing Scoop dependency {dep} for {name}; refusing pruning")
                    pending.extend(matches - retained)
                    retained.update(matches)
            elif isinstance(item, list):
                objects.extend(item)
    return [("scoop", ["scoop", "uninstall", *(["--global"] if global_ else []), name],
             {name + (" (global)" if global_ else "")})
            for name, global_ in sorted(installed.keys() - retained)]


def apt_removals(output):
    removals = set()
    for line in output.splitlines():
        if line.startswith(("Inst ", "Conf ")):
            raise RuntimeError("APT pruning unexpectedly installs/configures packages")
        if line.startswith("Remv "):
            removals.add(line.split()[1])
    return removals


def apt_packages():
    rows = capture(
        "dpkg-query", "-W",
        "-f=${binary:Package}\t${db:Status-Status}\t${Essential}\t${Protected}\t${Priority}\n",
    )
    return [line.split("\t") for line in rows.splitlines()]


def apt_plan(wanted):
    installed, protected = set(), set()
    for name, status, essential, protect, priority in apt_packages():
        if status != "installed":
            continue
        installed.add(name)
        base = name.split(":")[0]
        if (
            essential == "yes"
            or protect == "yes"
            or priority in {"required", "important", "standard"}
            or base in {"sudo", "apt", "dpkg"}
            or base.startswith(("linux-", "grub", "shim", "python3"))
        ):
            protected.add(name)
    unresolved = wanted - installed - {name.split(":")[0] for name in installed}
    if unresolved:
        raise RuntimeError("Cannot map configured APT roots to installed packages; install first and use concrete package names: " + ", ".join(sorted(unresolved)))
    held = set(capture("apt-mark", "showhold").splitlines())
    roots = {
        name
        for name in installed
        if name in protected | held | wanted or name.split(":")[0] in held | wanted
    }
    # Resolve dependency retention with a private auto/manual map, never the live one.
    with tempfile.TemporaryDirectory(prefix="package-prune-") as directory:
        state = Path(directory) / "extended_states"
        live = Path("/var/lib/apt/extended_states")
        if live.exists():
            shutil.copyfile(live, state)
        else:
            state.touch()
        for mode, names in (("auto", installed - roots), ("manual", roots)):
            if names:
                capture("apt-mark", "-f", str(state), mode, *sorted(names))
        output = capture(
            "apt-get",
            "-o",
            f"Dir::State::extended_states={state}",
            "--simulate",
            "autoremove",
        )
    removals = apt_removals(output)
    root_bases = {name.split(":")[0] for name in roots}
    if any(name in roots or name.split(":")[0] in root_bases for name in removals):
        raise RuntimeError("APT simulation would remove a configured/protected package")
    return removals


def check_apt_transaction(names):
    command = ["apt-get", "--no-auto-remove", "remove", *sorted(names)]
    actual = apt_removals(capture("apt-get", "--simulate", *command[1:]))
    if actual != names:
        raise RuntimeError("APT removal plan changed; rerun and review the new plan")
    return command


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Preview installs and removals; only inventories and private APT simulations run",
    )
    parser.add_argument(
        "--yes", action="store_true", help="Accept install and prune confirmations"
    )
    parser.add_argument(
        "--prune",
        action="store_true",
        help="Remove unlisted globals and APT packages not needed by configured/protected roots",
    )
    parser.add_argument(
        "--manifest-dir",
        type=Path,
        default=Path(
            os.environ.get(
                "PACKAGE_MANIFEST_DIR", str(Path.home() / ".config/packages")
            )
        ),
    )
    parser.add_argument("--scoop-file", type=Path, help="Scoop config (default: ../scoop/scoopfile.json beside the manifest directory)")
    args = parser.parse_args()
    if not args.manifest_dir.is_dir():
        raise ValueError(f"Manifest directory not found: {args.manifest_dir}")
    manifests = {}
    for manager, (filename, executable, _) in MANAGERS.items():
        path = args.manifest_dir / filename
        if not path.exists():
            print(f"Skipping {manager}: missing manifest (never pruned).")
            continue
        specs = [
            re.split(r"\s+#", line, maxsplit=1)[0].strip()
            for line in path.read_text(encoding="utf-8-sig").splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        ]
        if args.prune:
            for spec in specs:
                name_of(manager, spec)
        if any(spec.startswith("-") for spec in specs):
            raise ValueError(f"Package specs cannot be options: {path}")
        if not find_executable(executable):
            print(f"Skipping {manager}: {executable} is not installed.")
            continue
        manifests[manager] = specs
    scoop_file = args.scoop_file or args.manifest_dir.parent / "scoop/scoopfile.json"
    scoop_wanted = None
    if scoop_file.exists() and find_executable("scoop"):
        scoop_config = json.loads(scoop_file.read_text(encoding="utf-8-sig"))
        scoop_wanted = set(scoop_apps(scoop_config))
    else:
        print("Skipping Scoop: config missing or Scoop is not installed (never pruned).")
    if not args.dry_run:
        confirm(f"Install packages from {args.manifest_dir} and {scoop_file}?", args.yes)
    for manager, specs in manifests.items():
        if not specs:
            continue
        if manager == "apt":
            installed = {name for name, status, _, _, _ in apt_packages() if status == "installed"}
            installed.update(name.split(":")[0] for name in list(installed))
        else:
            try:
                installed = inventory(manager, for_pruning=False)[0]
            except InventoryUnavailable as error:
                print(f"{manager} inventory unavailable: {error}; forwarding unverified install requests.")
                installed = set()
        # Bare installed names need no work. Let managers resolve version/source specs.
        specs = [spec for spec in specs if spec not in installed]
        if not specs:
            continue
        command = MANAGERS[manager][2]
        if manager == "cargo":
            command = [*command, "--root", str(cargo_root())]
        if manager == "apt":
            run(["sudo", "apt-get", "update"], args.dry_run)
            run([*command, *specs], args.dry_run)
        else:
            for spec in specs:
                run([*command, spec], args.dry_run)
    if scoop_wanted is not None:
        installed = scoop_apps(json.loads(capture("scoop", "export")))
        missing = {key for key in scoop_wanted if key not in installed
                   or "install failed" in installed[key].get("info", "").lower()}
        if missing:
            scoop_config["apps"] = [app for app in scoop_config["apps"]
                                    if set(scoop_apps({"apps": [app]})) & missing]
            print("Install Scoop: " + ", ".join(name + (" (global)" if global_ else "")
                                               for name, global_ in sorted(missing)))
            with tempfile.TemporaryDirectory(prefix="scoop-install-") as directory:
                pending = Path(directory) / "scoopfile.json"
                pending.write_text(json.dumps(scoop_config), encoding="utf-8")
                run(["scoop", "import", str(pending)], args.dry_run)
    if not args.prune:
        return
    plans = scoop_plan(scoop_wanted) if scoop_wanted is not None else []
    for manager, command, extra in plans:
        print(f"Prune {manager}: {', '.join(sorted(extra))}")
        run(command, dry_run=True)
    # Plan before removing anything; unavailable inventories are never pruned. APT goes last.
    for manager, specs in sorted(manifests.items(), key=lambda item: item[0] == "apt"):
        wanted = {name_of(manager, spec) for spec in specs}
        if manager == "apt":
            extra = apt_plan(wanted)
            command = check_apt_transaction(extra) if extra else []
            command = ["sudo", *command] if command else []
        else:
            try:
                installed, command, protected = inventory(manager)
            except InventoryUnavailable as error:
                print(f"Skipping {manager} pruning: {error}; no packages will be removed for this manager.")
                continue
            extra = installed - wanted - protected
            command = [*command, *sorted(extra)]
        if extra:
            plans.append((manager, command, extra))
            print(f"Prune {manager}: {', '.join(sorted(extra))}")
            if manager == "pipx":
                for name in sorted(extra):
                    run(["pipx", "uninstall", name], dry_run=True)
            else:
                run(command, dry_run=True)
    if not plans:
        print("Nothing to prune.")
        return
    if args.dry_run:
        return
    confirm("Remove ALL packages shown above?", args.yes)
    for manager, command, extra in plans:
        if manager == "apt":
            check_apt_transaction(extra)
            if args.yes:
                command.insert(2, "-y")
        if manager == "pipx":
            for name in sorted(extra):
                run(["pipx", "uninstall", name])
        else:
            run(command)


if __name__ == "__main__":
    try:
        main()
    except (
        OSError,
        ValueError,
        TypeError,
        RuntimeError,
        subprocess.CalledProcessError,
        EOFError,
    ) as error:
        print(f"install-package-manifests: {error}", file=sys.stderr)
        sys.exit(1)
