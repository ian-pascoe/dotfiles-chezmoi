{
  "mcpServers": {
    "executor": {
      "enabled": true,
      "url": "https://exe.ianpascoe.dev/mcp?mode=passthrough",
      "oauth": {
        "scope": "openid"
      },
      "exposure": "deferred"
    },
    "browser-use": {
      "enabled": true,
      "command": "pnpm",
      "args": [
        "dlx",
        "@playwright/mcp@latest",
        "--extension",
        "--output-dir",
        "/home/ianpascoe/.cache/playwright-mcp"
      ],
      "env": {
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "${DEFAULT_BROWSER_EXECUTABLE_PATH}",
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "${PLAYWRIGHT_MCP_EXTENSION_TOKEN}",
        "DISPLAY": ":1",
        "XDG_SESSION_TYPE": "x11"
      },
      "description": "Drives the user's real Helium browser via the Playwright MCP extension (navigate, snapshot, click, screenshot, network/console).",
      "exposure": "deferred"
    },
    "computer-use": {
      "enabled": true,
      "command": "cua-driver",
      "args": [
        "mcp"
      ],
      "env": {
        "DISPLAY": ":1",
        "XDG_SESSION_TYPE": "x11"
      },
      "description": "Desktop GUI control (screenshots, mouse, keyboard, windows, accessibility tree) on X11 display :1 via cua-driver.",
      "exposure": "deferred"
    }
  }
}
