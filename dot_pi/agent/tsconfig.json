{
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "types": ["@types/node"],
    "lib": ["esnext"],
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "exclude": ["node_modules"]
}
