{
  "lastChangelogVersion": "0.84.2",
  "packages": [
    "npm:@dietrichgebert/ponytail",
    "npm:@howaboua/pi-codex-conversion",
    "npm:@ian-pascoe/pi-bible-verses",
    "npm:@ian-pascoe/pi-dap",
    "npm:@ian-pascoe/pi-formatter",
    "npm:@ian-pascoe/pi-git-checkpoints",
    "npm:@ian-pascoe/pi-git-status-widget",
    "npm:@ian-pascoe/pi-lsp",
    "npm:@ian-pascoe/pi-minimal-subagents",
    "npm:@ian-pascoe/pi-tps-tracker",
    "npm:@plannotator/pi-extension",
    "npm:pi-autoresearch",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:@ian-pascoe/pi-codemode"
  ],
  "defaultModel": "gpt-5.6-sol",
  "defaultProjectTrust": "always",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-luna",
    "opencode-go/kimi-k3",
    "opencode-go/glm-5.2",
    "opencode-go/ox-alpha-free"
  ],
  "enableInstallTelemetry": false,
  "collapseChangelog": true,
  "showCacheMissNotices": true,
  "tuiMode": "fullscreen",
  "minimalSubagents": {
    "modelRoles": {
      "default": "openai-codex/gpt-5.6-sol:high",
      "small": "openai-codex/gpt-5.6-luna",
      "medium": "openai-codex/gpt-5.6-terra",
      "large": "openai-codex/gpt-5.6-sol",
      "design": "opencode-go/kimi-k3:max",
      "explore": "openai-codex/gpt-5.6-luna:high",
      "plan": "openai-codex/gpt-5.6-sol:xhigh",
      "research": "openai-codex/gpt-5.6-luna:high",
      "review": "openai-codex/gpt-5.6-sol:xhigh",
      "task": "openai-codex/gpt-5.6-sol:medium"
    }
  },
  "codemode": {
    "tools": [
      {
        "pattern": "executor_*",
        "exposure": "direct-only"
      }
    ]
  }
}
