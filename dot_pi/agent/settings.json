{
  "lastChangelogVersion": "0.75.3",
  "packages": [
    "npm:@caplets/pi",
    "npm:@juicesharp/rpiv-args",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-btw",
    "npm:@juicesharp/rpiv-todo",
    "npm:@narumitw/pi-goal",
    "npm:pi-byterover",
    "npm:pi-lens",
    "npm:pi-markdown-preview",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:pi-subdir-context",
    "npm:pi-web-access"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "low",
  "theme": "terminal-ansi",
  "subagents": {
    "agentOverrides": {
      "worker": {
        "model": "openai-codex/gpt-5.5",
        "thinking": "low"
      },
      "scout": {
        "model": "openai-codex/gpt-5.4-mini",
        "thinking": "medium"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.4-mini",
        "thinking": "medium"
      },
      "context-builder": {
        "model": "openai-codex/gpt-5.4-mini",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.5",
        "thinking": "high"
      },
      "planner": {
        "model": "openai-codex/gpt-5.5",
        "thinking": "high"
      }
    }
  }
}
