{
  "lastChangelogVersion": "0.75.3",
  "packages": [
    "npm:@caplets/pi",
    "npm:@howaboua/pi-codex-conversion",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-btw",
    "npm:@juicesharp/rpiv-todo",
    "npm:@narumitw/pi-goal",
    "npm:@victor-software-house/pi-curated-themes",
    "npm:pi-intercom",
    "npm:pi-lens",
    "npm:pi-markdown-preview",
    "npm:pi-mcp-adapter",
    "npm:pi-memory-md",
    "npm:pi-subagents",
    "npm:pi-subdir-context",
    "npm:pi-terminal-theme"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "low",
  "theme": "catppuccin-mocha",
  "quietStartup": true,
  "collapseChangelog": true,
  "showHardwareCursor": true,
  "subagents": {
    "agentOverrides": {
      "worker": {
        "thinking": "low"
      },
      "scout": {
        "model": "openai-codex/gpt-5.4-mini",
        "thinking": "medium"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.4-mini",
        "thinking": "high"
      },
      "context-builder": {
        "model": "openai-codex/gpt-5.4-mini",
        "thinking": "high"
      },
      "reviewer": {
        "thinking": "medium"
      },
      "planner": {
        "thinking": "medium"
      }
    }
  },
  "powerline": {
    "preset": "default",
    "fixedEditor": false
  },
  "pi-memory-md": {
    "memoryDir": {
      "repoUrl": "https://github.com/ian-pascoe/memory-md.git",
      "localPath": "~/.pi/memory-md",
      "globalMemory": "global"
    }
  }
}
