{
  "lastChangelogVersion": "0.85.1",
  "packages": [
    "npm:@dietrichgebert/ponytail",
    "npm:@narumitw/pi-goal",
    "npm:@plannotator/pi-extension",
    "npm:pi-autoresearch",
    {
      "source": "git:github.com/ian-pascoe/pi-extensions",
      "extensions": [
        "packages/pi-bible-verses/src/index.ts",
        "packages/pi-context-management/src/index.ts",
        "packages/pi-dap/src/index.ts",
        "packages/pi-formatter/src/index.ts",
        "packages/pi-git-checkpoints/src/index.ts",
        "packages/pi-lsp/src/index.ts",
        "packages/pi-mcp/src/index.ts",
        "packages/pi-minimal-subagents/src/index.ts",
        "packages/pi-skills-selector/src/index.ts",
        "packages/pi-todo/src/index.ts",
        "packages/pi-tps-tracker/src/index.ts",
        "packages/pi-web-tools/src/index.ts",
        "packages/pi-codemode/src/index.ts"
      ],
      "skills": [
        "packages/pi-bible-verses/skills/pi-bible-verses/SKILL.md",
        "packages/pi-context-management/skills/pi-context-management/SKILL.md",
        "packages/pi-dap/skills/pi-dap/SKILL.md",
        "packages/pi-formatter/skills/pi-formatter/SKILL.md",
        "packages/pi-git-checkpoints/skills/pi-git-checkpoints/SKILL.md",
        "packages/pi-lsp/skills/pi-lsp/SKILL.md",
        "packages/pi-mcp/skills/pi-mcp/SKILL.md",
        "packages/pi-minimal-subagents/skills/pi-minimal-subagents/SKILL.md",
        "packages/pi-skills-selector/skills/pi-skills-selector/SKILL.md",
        "packages/pi-todo/skills/pi-todo/SKILL.md",
        "packages/pi-tps-tracker/skills/pi-tps-tracker/SKILL.md",
        "packages/pi-web-tools/skills/pi-web-tools/SKILL.md",
        "packages/pi-codemode/skills/pi-codemode/SKILL.md"
      ]
    }
  ],
  "defaultProjectTrust": "always",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-luna",
    "opencode-go/glm-5.3",
    "opencode-go/glm-5.3-flash"
  ],
  "enableInstallTelemetry": false,
  "collapseChangelog": true,
  "showCacheMissNotices": true,
  "skills": ["~/.cua-driver/skills/cua-driver"],
  "tuiMode": "fullscreen",
  "doubleEscapeAction": "none",
  "theme": "dracula",
  "minimalSubagents": {
    "modelRoles": {
      "debug": {
        "model": "openai-codex/gpt-6-astra:xhigh",
        "hint": "Use to diagnose failures or isolate regressions."
      },
      "default": {
        "model": "openai-codex/gpt-6-astra:high",
        "hint": "Use when work spans roles or no specialized role fits."
      },
      "explore": {
        "model": "openai-codex/gpt-5.6-luna:medium",
        "hint": "Use to locate code, trace behavior, or find reusable patterns."
      },
      "plan": {
        "model": "openai-codex/gpt-6-astra:xhigh",
        "hint": "Use to clarify requirements, weigh designs, or plan implementation."
      },
      "research": {
        "model": "openai-codex/gpt-5.6-luna:high",
        "hint": "Use when technical questions need external sources."
      },
      "review": {
        "model": "openai-codex/gpt-6-astra:xhigh",
        "hint": "Use when changes need independent correctness or spec review."
      },
      "security": {
        "model": "openai-codex/gpt-6-astra:xhigh",
        "hint": "Use for threat modeling, security audits, or vulnerability assessment."
      },
      "task": {
        "model": "openai-codex/gpt-6-astra:medium",
        "hint": "Use when a scoped implementation task has a settled approach."
      }
    }
  },
  "codemode": {
    "tools": [
      {
        "pattern": "mcp__*",
        "exposure": "codemode-only"
      },
      {
        "pattern": "mcp__executor__*",
        "exposure": "direct-and-codemode"
      },
      {
        "pattern": "mcp__executor__execute",
        "exposure": "direct-only"
      }
    ]
  },
  "mcp": {
    "servers": {
      "executor": {
        "enabled": true,
        "url": "https://exe.ianpascoe.dev/mcp"
      },
      "browser-use": {
        "enabled": true,
        "command": "pnpm",
        "args": ["dlx", "@playwright/mcp@latest", "--extension"],
        "environment": {
          "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "${DEFAULT_BROWSER_EXECUTABLE_PATH}",
          "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "${PLAYWRIGHT_MCP_EXTENSION_TOKEN}"
        }
      },
      "computer-use": {
        "enabled": true,
        "command": "cua-driver",
        "args": ["mcp"],
        "environment": {
          "DISPLAY": ":1",
          "XDG_SESSION_TYPE": "x11"
        }
      },
      "terminal-control": {
        "enabled": true,
        "command": "termctrl",
        "args": ["mcp"]
      }
    }
  },
  "lsp": {
    "servers": {
      "typescript": {
        "command": "pnpm",
        "args": ["dlx", "typescript@latest", "--lsp", "--stdio"],
        "languages": [
          {
            "extensions": [".js", ".mjs", ".cjs"],
            "languageId": "javascript"
          },
          {
            "extensions": [".jsx"],
            "languageId": "javascriptreact"
          },
          {
            "extensions": [".ts", ".mts", ".cts"],
            "languageId": "typescript"
          },
          {
            "extensions": [".tsx"],
            "languageId": "typescriptreact"
          }
        ],
        "rootMarkers": ["tsconfig.json", "jsconfig.json"],
        "requireRootMarker": true
      },
      "oxlint": {
        "command": "pnpm",
        "args": ["dlx", "oxlint@latest", "--lsp"],
        "languages": [
          {
            "extensions": [".js", ".mjs", ".cjs"],
            "languageId": "javascript"
          },
          {
            "extensions": [".jsx"],
            "languageId": "javascriptreact"
          },
          {
            "extensions": [".ts", ".mts", ".cts"],
            "languageId": "typescript"
          },
          {
            "extensions": [".tsx"],
            "languageId": "typescriptreact"
          }
        ],
        "rootMarkers": [".oxlintrc.json"],
        "requireRootMarker": true
      },
      "rust": {
        "command": "rust-analyzer",
        "languages": [
          {
            "extensions": [".rs"],
            "languageId": "rust"
          }
        ],
        "rootMarkers": ["Cargo.toml"],
        "requireRootMarker": true
      },
      "basedpyright": {
        "command": "uvx",
        "args": ["--from", "basedpyright", "basedpyright-langserver", "--stdio"],
        "languages": [
          {
            "extensions": [".py", ".pyi", ".pyw"],
            "languageId": "python"
          }
        ],
        "rootMarkers": [
          "pyproject.toml",
          "pyrightconfig.json",
          "setup.py",
          "setup.cfg",
          "requirements.txt",
          "Pipfile"
        ]
      },
      "ruff": {
        "command": "ruff",
        "args": ["server"],
        "languages": [
          {
            "extensions": [".py", ".pyi", ".pyw"],
            "languageId": "python"
          }
        ],
        "rootMarkers": ["pyproject.toml", "ruff.toml", ".ruff.toml"]
      },
      "gopls": {
        "command": "gopls",
        "languages": [
          {
            "extensions": [".go"],
            "languageId": "go"
          },
          {
            "fileNames": ["go.mod"],
            "languageId": "go.mod"
          },
          {
            "fileNames": ["go.work"],
            "languageId": "go.work"
          }
        ],
        "rootMarkers": ["go.work", "go.mod"],
        "requireRootMarker": true
      },
      "clangd": {
        "command": "clangd",
        "languages": [
          {
            "extensions": [".c", ".h"],
            "languageId": "c"
          },
          {
            "extensions": [".cc", ".cpp", ".cxx", ".C", ".hh", ".hpp", ".hxx", ".ipp", ".tpp"],
            "languageId": "cpp"
          },
          {
            "extensions": [".mm"],
            "languageId": "objective-cpp"
          },
          {
            "extensions": [".cu", ".cuh"],
            "languageId": "cuda-cpp"
          }
        ],
        "rootMarkers": [".clangd", "compile_commands.json", "compile_flags.txt", "CMakeLists.txt"]
      },
      "java": {
        "command": "jdtls",
        "languages": [
          {
            "extensions": [".java"],
            "languageId": "java"
          }
        ],
        "rootMarkers": [
          "pom.xml",
          "settings.gradle",
          "settings.gradle.kts",
          "build.gradle",
          "build.gradle.kts"
        ],
        "requireRootMarker": true
      },
      "kotlin": {
        "command": "intellij-server",
        "args": ["--stdio"],
        "languages": [
          {
            "extensions": [".kt", ".kts"],
            "languageId": "kotlin"
          }
        ],
        "rootMarkers": [
          "settings.gradle",
          "settings.gradle.kts",
          "pom.xml",
          "build.gradle",
          "build.gradle.kts"
        ],
        "requireRootMarker": true
      },
      "csharp": {
        "command": "csharp-ls",
        "languages": [
          {
            "extensions": [".cs"],
            "languageId": "csharp"
          }
        ],
        "rootMarkers": ["*.sln", "*.slnx", "*.csproj"],
        "requireRootMarker": true,
        "initializationOptions": {
          "AutomaticWorkspaceInit": true
        }
      },
      "ruby": {
        "command": "ruby-lsp",
        "languages": [
          {
            "extensions": [".rb", ".rake", ".gemspec"],
            "fileNames": ["Gemfile", "Rakefile", "Guardfile"],
            "languageId": "ruby"
          }
        ],
        "rootMarkers": ["Gemfile", "*.gemspec"],
        "requireRootMarker": true
      },
      "php": {
        "command": "pnpm",
        "args": ["dlx", "intelephense@latest", "--stdio"],
        "languages": [
          {
            "extensions": [".php", ".phtml"],
            "languageId": "php"
          }
        ],
        "rootMarkers": ["composer.json"],
        "settings": {
          "intelephense": {
            "telemetry": {
              "enabled": false
            }
          }
        }
      },
      "swift": {
        "command": "sourcekit-lsp",
        "languages": [
          {
            "extensions": [".swift"],
            "languageId": "swift"
          }
        ],
        "rootMarkers": ["Package.swift", "*.xcodeproj", "*.xcworkspace"],
        "requireRootMarker": true
      },
      "dart": {
        "command": "dart",
        "args": ["language-server", "--protocol=lsp"],
        "languages": [
          {
            "extensions": [".dart"],
            "languageId": "dart"
          }
        ],
        "rootMarkers": ["pubspec.yaml"],
        "requireRootMarker": true
      },
      "lua": {
        "command": "lua-language-server",
        "languages": [
          {
            "extensions": [".lua"],
            "languageId": "lua"
          }
        ],
        "rootMarkers": [".luarc.json", ".luarc.jsonc"],
        "settings": {
          "Lua": {
            "telemetry": {
              "enable": false
            }
          }
        }
      },
      "bash": {
        "command": "pnpm",
        "args": ["dlx", "bash-language-server@latest", "start"],
        "languages": [
          {
            "extensions": [".sh", ".bash"],
            "fileNames": [".bashrc", ".bash_profile", ".bash_login", ".bash_logout", ".profile"],
            "languageId": "shellscript"
          }
        ],
        "rootMarkers": [".shellcheckrc"],
        "settings": {
          "bashIde": {
            "globPattern": "*@(.sh|.bash)"
          }
        }
      },
      "html": {
        "command": "pnpm",
        "args": [
          "--package=vscode-langservers-extracted@latest",
          "dlx",
          "vscode-html-language-server",
          "--stdio"
        ],
        "languages": [
          {
            "extensions": [".html", ".htm"],
            "languageId": "html"
          }
        ],
        "rootMarkers": [],
        "initializationOptions": {
          "provideFormatter": true
        }
      },
      "css": {
        "command": "pnpm",
        "args": [
          "--package=vscode-langservers-extracted@latest",
          "dlx",
          "vscode-css-language-server",
          "--stdio"
        ],
        "languages": [
          {
            "extensions": [".css"],
            "languageId": "css"
          },
          {
            "extensions": [".scss"],
            "languageId": "scss"
          },
          {
            "extensions": [".less"],
            "languageId": "less"
          }
        ],
        "rootMarkers": [],
        "initializationOptions": {
          "provideFormatter": true
        }
      },
      "json": {
        "command": "pnpm",
        "args": [
          "--package=vscode-langservers-extracted@latest",
          "dlx",
          "vscode-json-language-server",
          "--stdio"
        ],
        "languages": [
          {
            "extensions": [".json"],
            "languageId": "json"
          },
          {
            "extensions": [".jsonc"],
            "languageId": "jsonc"
          }
        ],
        "rootMarkers": [],
        "initializationOptions": {
          "provideFormatter": true
        }
      },
      "yaml": {
        "command": "pnpm",
        "args": ["dlx", "yaml-language-server@latest", "--stdio"],
        "languages": [
          {
            "extensions": [".yaml", ".yml"],
            "languageId": "yaml"
          }
        ],
        "rootMarkers": [],
        "settings": {
          "redhat": {
            "telemetry": {
              "enabled": false
            }
          },
          "yaml": {
            "format": {
              "enable": true
            }
          }
        }
      },
      "toml": {
        "command": "taplo",
        "args": ["lsp", "stdio"],
        "languages": [
          {
            "extensions": [".toml"],
            "languageId": "toml"
          }
        ],
        "rootMarkers": ["taplo.toml", ".taplo.toml"]
      },
      "markdown": {
        "command": "marksman",
        "args": ["server"],
        "languages": [
          {
            "extensions": [".md", ".markdown"],
            "languageId": "markdown"
          }
        ],
        "rootMarkers": [".marksman.toml"]
      },
      "sql": {
        "command": "pnpm",
        "args": ["dlx", "sql-language-server@latest", "up", "--method", "stdio"],
        "languages": [
          {
            "extensions": [".sql"],
            "languageId": "sql"
          }
        ],
        "rootMarkers": [".sqllsrc.json"],
        "requireRootMarker": true
      },
      "r": {
        "command": "R",
        "args": ["--no-echo", "-e", "languageserver::run()"],
        "languages": [
          {
            "extensions": [".r", ".R"],
            "languageId": "r"
          }
        ],
        "rootMarkers": ["*.Rproj", "DESCRIPTION"]
      },
      "dockerfile": {
        "command": "pnpm",
        "args": [
          "--package=dockerfile-language-server-nodejs@latest",
          "dlx",
          "docker-langserver",
          "--stdio"
        ],
        "languages": [
          {
            "extensions": [".dockerfile"],
            "fileNames": ["Dockerfile", "Containerfile"],
            "languageId": "dockerfile"
          }
        ],
        "rootMarkers": ["Dockerfile", "Containerfile"]
      },
      "terraform": {
        "command": "terraform-ls",
        "args": ["serve"],
        "languages": [
          {
            "extensions": [".tf"],
            "languageId": "terraform"
          },
          {
            "extensions": [".tfvars"],
            "languageId": "terraform-vars"
          }
        ],
        "rootMarkers": [".terraform", ".terraform.lock.hcl", "*.tf"],
        "requireRootMarker": true
      },
      "nix": {
        "command": "nil",
        "languages": [
          {
            "extensions": [".nix"],
            "languageId": "nix"
          }
        ],
        "rootMarkers": ["flake.nix", "shell.nix", "default.nix"],
        "requireRootMarker": true
      },
      "zig": {
        "command": "zls",
        "languages": [
          {
            "extensions": [".zig"],
            "languageId": "zig"
          }
        ],
        "rootMarkers": ["zls.json", "build.zig"]
      }
    }
  },
  "formatter": {
    "formatters": {
      "oxfmt": {
        "command": "pnpm",
        "args": ["dlx", "oxfmt@latest", "--no-error-on-unmatched-pattern", "$FILE"],
        "files": {
          "extensions": [
            ".js",
            ".jsx",
            ".ts",
            ".tsx",
            ".mjs",
            ".cjs",
            ".mts",
            ".cts",
            ".json",
            ".jsonc",
            ".md",
            ".yml",
            ".yaml",
            ".css",
            ".scss",
            ".less",
            ".html",
            ".htm",
            ".vue",
            ".mdx",
            ".graphql",
            ".gql",
            ".hbs"
          ]
        },
        "rootMarkers": [".oxfmtrc.json", ".oxfmtrc.jsonc"],
        "requireRootMarker": true
      },
      "rustfmt": {
        "command": "rustfmt",
        "args": ["$FILE"],
        "files": {
          "extensions": [".rs"]
        },
        "rootMarkers": ["Cargo.toml"],
        "requireRootMarker": true
      },
      "ruff": {
        "command": "ruff",
        "args": ["format", "$FILE"],
        "files": {
          "extensions": [".py", ".pyi", ".pyw"]
        },
        "rootMarkers": ["pyproject.toml", "ruff.toml", ".ruff.toml"]
      },
      "gofmt": {
        "command": "gofmt",
        "args": ["-w", "$FILE"],
        "files": {
          "extensions": [".go"]
        },
        "rootMarkers": ["go.work", "go.mod"]
      },
      "clang-format": {
        "command": "clang-format",
        "args": ["-i", "$FILE"],
        "files": {
          "extensions": [
            ".c",
            ".h",
            ".cc",
            ".cpp",
            ".cxx",
            ".C",
            ".hh",
            ".hpp",
            ".hxx",
            ".ipp",
            ".tpp",
            ".mm",
            ".cu",
            ".cuh"
          ]
        },
        "rootMarkers": [".clang-format", "_clang-format"]
      },
      "google-java-format": {
        "command": "google-java-format",
        "args": ["--replace", "$FILE"],
        "files": {
          "extensions": [".java"]
        },
        "rootMarkers": ["pom.xml", "build.gradle", "build.gradle.kts"]
      },
      "ktlint": {
        "command": "ktlint",
        "args": ["--format", "$FILE"],
        "files": {
          "extensions": [".kt", ".kts"]
        },
        "rootMarkers": [
          "settings.gradle",
          "settings.gradle.kts",
          "pom.xml",
          "build.gradle",
          "build.gradle.kts"
        ]
      },
      "csharpier": {
        "command": "csharpier",
        "args": ["format", "$FILE"],
        "files": {
          "extensions": [".cs"]
        },
        "rootMarkers": [
          ".csharpierrc",
          ".csharpierrc.json",
          ".csharpierrc.yaml",
          "*.sln",
          "*.slnx",
          "*.csproj"
        ],
        "requireRootMarker": true
      },
      "rubocop": {
        "command": "bundle",
        "args": [
          "exec",
          "rubocop",
          "--autocorrect",
          "--only",
          "Layout",
          "--force-exclusion",
          "$FILE"
        ],
        "files": {
          "extensions": [".rb", ".rake", ".gemspec"],
          "fileNames": ["Gemfile", "Rakefile", "Guardfile"]
        },
        "rootMarkers": ["Gemfile"],
        "requireRootMarker": true
      },
      "php-cs-fixer": {
        "command": "php-cs-fixer",
        "args": ["fix", "--path-mode=intersection", "--allow-risky=no", "$FILE"],
        "files": {
          "extensions": [".php", ".phtml"]
        },
        "rootMarkers": [".php-cs-fixer.php", ".php-cs-fixer.dist.php"],
        "requireRootMarker": true
      },
      "swift-format": {
        "command": "swift",
        "args": ["format", "--in-place", "$FILE"],
        "files": {
          "extensions": [".swift"]
        },
        "rootMarkers": [".swift-format", "Package.swift", "*.xcodeproj", "*.xcworkspace"]
      },
      "dart-format": {
        "command": "dart",
        "args": ["format", "$FILE"],
        "files": {
          "extensions": [".dart"]
        },
        "rootMarkers": ["pubspec.yaml"],
        "requireRootMarker": true
      },
      "stylua": {
        "command": "stylua",
        "args": ["--search-parent-directories", "--respect-ignores", "$FILE"],
        "files": {
          "extensions": [".lua"]
        },
        "rootMarkers": ["stylua.toml", ".stylua.toml"]
      },
      "shfmt": {
        "command": "shfmt",
        "args": ["-w", "$FILE"],
        "files": {
          "extensions": [".sh", ".bash"],
          "fileNames": [".bashrc", ".bash_profile", ".bash_login", ".bash_logout", ".profile"]
        },
        "rootMarkers": []
      },
      "taplo": {
        "command": "taplo",
        "args": ["format", "$FILE"],
        "files": {
          "extensions": [".toml"]
        },
        "rootMarkers": ["taplo.toml", ".taplo.toml"]
      },
      "sqlfluff": {
        "command": "uvx",
        "args": ["sqlfluff", "format", "$FILE"],
        "files": {
          "extensions": [".sql"]
        },
        "rootMarkers": [".sqlfluff"],
        "requireRootMarker": true
      },
      "air": {
        "command": "air",
        "args": ["format", "$FILE"],
        "files": {
          "extensions": [".r", ".R"]
        },
        "rootMarkers": ["air.toml", ".air.toml", "*.Rproj", "DESCRIPTION"]
      },
      "terraform-fmt": {
        "command": "terraform",
        "args": ["fmt", "$FILE"],
        "files": {
          "extensions": [".tf", ".tfvars"]
        },
        "rootMarkers": [".terraform", ".terraform.lock.hcl", "*.tf"],
        "requireRootMarker": true
      },
      "nixfmt": {
        "command": "nixfmt",
        "args": ["$FILE"],
        "files": {
          "extensions": [".nix"]
        },
        "rootMarkers": ["flake.nix", "shell.nix", "default.nix"],
        "requireRootMarker": true
      },
      "zig-fmt": {
        "command": "zig",
        "args": ["fmt", "$FILE"],
        "files": {
          "extensions": [".zig"]
        },
        "rootMarkers": ["build.zig"]
      }
    }
  }
}
