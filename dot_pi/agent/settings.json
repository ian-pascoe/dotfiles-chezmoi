{
  "lastChangelogVersion": "0.79.10",
  "packages": [
    "git:github.com/EveryInc/compound-engineering-plugin",
    "git:github.com/obra/superpowers",
    "npm:@caplets/pi",
    "npm:@howaboua/pi-codex-conversion",
    "npm:@juicesharp/rpiv-args",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-btw",
    "npm:@juicesharp/rpiv-todo",
    "npm:@ramarivera/pi-skill-selector",
    "npm:pi-adaptive-thinking",
    "npm:pi-autoresearch",
    "npm:pi-intercom",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:pi-subdir-context",
    "npm:pi-terminal-theme",
    "npm:pi-web-access"
