[Unit]
Description=Caplets Server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/ianpascoe
ExecStart=/usr/bin/env zsh -lc 'caplets serve --transport http --host 127.0.0.1 --port 5387'
Environment=CAPLETS_MODE=local
Restart=always
RestartSec=5
TimeoutStopSec=30
TimeoutStartSec=30
SuccessExitStatus=0 143
KillMode=control-group

[Install]
WantedBy=default.target
