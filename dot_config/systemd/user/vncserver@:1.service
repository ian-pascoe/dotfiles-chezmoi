[Unit]
Description=VNC Server for display :1
After=network.target

[Service]
Type=simple
# Keep the backend port separate from Tailscale Serve's 5901; TigerVNC checks wildcard binds.
ExecStart=/usr/bin/vncserver :1 -fg -localhost yes -rfbport 15901 -geometry 1280x800 -depth 24 -AcceptSetDesktopSize=0
ExecStop=/usr/bin/vncserver -kill :1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
