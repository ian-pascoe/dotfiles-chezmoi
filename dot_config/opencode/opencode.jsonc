{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "permission": {
    // Don't care if the agent can read/write these
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/**": "allow",
      "/private/tmp": "allow",
      "/private/tmp/**": "allow",
      "~/.config/opencode": "allow",
      "~/.config/opencode/**": "allow",
      "~/.local/share/opencode": "allow",
      "~/.local/share/opencode/**": "allow",
      "~/.local/state/opencode": "allow",
      "~/.local/state/opencode/**": "allow",
      "~/.cache/opencode": "allow",
      "~/.cache/opencode/**": "allow",
      "~/.agents": "allow",
      "~/.agents/**": "allow",
    },
  },
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "agent": {},
  "mcp": {
    "executor": {
      "enabled": true,
      "type": "remote",
      "url": "{env:EXECUTOR_BASE_URL}/mcp?elicitation_mode=native",
      "headers": {
        "Authorization": "Bearer {env:EXECUTOR_API_KEY}",
      },
    },
  },
  "lsp": true,
  "formatter": true,
  "enabled_providers": ["openai", "opencode-go"],
  "username": "ianpascoe",
}
