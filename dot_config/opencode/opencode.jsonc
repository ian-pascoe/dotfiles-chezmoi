{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@caplets/opencode@latest",
    "compound-engineering@git+https://github.com/EveryInc/compound-engineering-plugin.git",
    "opencode-adaptive-thinking@latest",
  ],
  "permission": {
    // Don't care if the agent can read/write these
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/**": "allow",
      "/private/tmp": "allow",
      "/private/tmp/**": "allow",
      "~/.config/opencode": "allow",
      "~/.config/opencode/**": "allow",
      "~/.local/share/opencode": "allow",
      "~/.local/share/opencode/**": "allow",
      "~/.local/state/opencode": "allow",
      "~/.local/state/opencode/**": "allow",
      "~/.cache/opencode": "allow",
      "~/.cache/opencode/**": "allow",
      "~/.agents": "allow",
      "~/.agents/**": "allow",
    },
    "google_search": "deny", // Use websearch (exa) instead
  },
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "agent": {
    // built-in agents with customizations
    "build": {
      "model": "openai/gpt-5.6-sol",
    },
    "plan": {
      "disable": true, // plan mode is for chumps
      "model": "openai/gpt-5.6-sol",
      "permission": {
        "edit": {
          "*": "deny",
          "**/plans": "allow",
          "**/plans/**": "allow",
          "**/specs": "allow",
          "**/specs/**": "allow",
        },
      },
    },
    "explore": {
      "model": "openai/gpt-5.6-sol",
      "permission": {
        "skill": "allow", // Disabled by default
      },
    },
    "general": {
      "model": "openai/gpt-5.6-sol",
    },
    "summary": {
      "model": "openrouter/openrouter/free",
    },
    "title": {
      "model": "openrouter/openrouter/free",
    },
    "compaction": {
      "model": "openai/gpt-5.6-sol",
    },
  },
  "mcp": {},
  "lsp": {
    "biome": {
      "command": ["biome", "lsp-proxy"],
      "extensions": [
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".json",
        ".jsonc",
        ".css",
        ".html",
      ],
    },
  },
  "formatter": {
    "stylua": {
      "command": ["stylua", "--search-parent-directories", "--stdin-filepath", "$FILE"],
      "extensions": [".lua", ".luau"],
    },
    "markdownlint-cli2": {
      "command": ["markdownlint-cli2", "--fix", "$FILE"],
      "extensions": [".md", ".mdx"],
    },
  },
  "enabled_providers": ["openai", "openrouter", "opencode", "opencode-go"],
  "username": "Ian",
}
